---
import HeaderMenu from '@components/Header/components/HeaderMenu/HeaderMenu.astro';
import HeaderMenuMobile from '@components/Header/components/HeaderMenuMobile/HeaderMenuMobile.astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);

const isPathActive = currentPath === pathname;
---

<style lang="scss">
  @use './Header.scss';
</style>

<nav class="navigation">
  <a class="logo" href="/">
    <span class="noko">NOKO</span>
    <span class="studio">STUDIO</span>
  </a>
  <HeaderMenuMobile isPathActive={isPathActive} />
  <HeaderMenu isPathActive={isPathActive} />
</nav>
