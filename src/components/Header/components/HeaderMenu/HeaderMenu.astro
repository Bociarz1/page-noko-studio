---
import { NAV_ELEMENTS } from "src/constants/navLinks";

interface Props {
    isPathActive: boolean;
}
const { isPathActive } = Astro.props;
---
<ul class="header-menu-desktop">
        {
            NAV_ELEMENTS.map((element) => (
                <li class={isPathActive ? "link--active" : ""}>
                    <a href={element.href}>{element.label}</a>
                </li>
            ))
        }
</ul>

<style lang="scss">
    @use "../../Header.scss";
    @use "./HeaderMenu.scss";
</style>