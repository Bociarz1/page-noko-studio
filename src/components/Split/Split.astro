---
import { Image } from 'astro:assets';
---

<style lang="scss">
  @use './Split.scss';
</style>

<section class="split">
  <div class="split__container">
    <div class="split__content">
      <h2 class="split__title section-title">
        Projektujemy z myślą
        <br />o Twoim komforcie
      </h2>
      <p class="split__desc section-description">
        Nasze projekty łączą nowoczesny design z funkcjonalnością.
        Tworzymy wnętrza, które nie tylko wyglądają pięknie, ale przede
        wszystkim są komfortowe i praktyczne w codziennym użytkowaniu.
      </p>
      <a href="/uslugi" class="split__link">
        Sprawdź naszą ofertę <span aria-hidden="true">→</span>
      </a>
    </div>
    
    <div class="split__images">
      <Image
        src="https://img.magnific.com/free-photo/portrait-woman-white-shirt_1303-12296.jpg?semt=ais_hybrid&w=740&q=80"
        alt="Projekt wnętrza — salon"
        class="split__img"
        width={400}
        height={533}
        format="webp"
        loading="lazy"
      />
      <Image
        src="https://img.magnific.com/free-photo/portrait-woman-white-shirt_1303-12296.jpg?semt=ais_hybrid&w=740&q=80"
        alt="Projekt wnętrza — pokój dzienny"
        class="split__img split__img--offset"
        width={400}
        height={533}
        format="webp"
        loading="lazy"
      />
    </div>
  </div>
</section>
