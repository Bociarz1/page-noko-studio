<style lang="scss">
  @use './About.scss';
</style>

<section class="about">
  <div class="about__container">
    <div class="about__header">
      <h2 class="about__title">O nas</h2>
      <p class="about__desc">
        NOKO Studio to zespół doświadczonych architektów wnętrz, którzy tworzą
        przestrzenie z pasją i dbałością o każdy detal.
      </p>
    </div>

    <div class="about__features">
      <div class="feature">
        <div class="feature__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <h3 class="feature__title">Wycena</h3>
        <p class="feature__desc">Indywidualne podejście do każdego projektu i budżetu.</p>
      </div>

      <div class="feature">
        <div class="feature__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        </div>
        <h3 class="feature__title">Projekt</h3>
        <p class="feature__desc">Kompleksowe rozwiązania i wizualizacje 3D.</p>
      </div>

      <div class="feature">
        <div class="feature__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="feature__title">Realizacja</h3>
        <p class="feature__desc">Nadzór nad wykonawstwem i dobór materiałów.</p>
      </div>
    </div>
  </div>
</section>
