---
import { Image } from 'astro:assets';
import heroImg from '@assets/images/kuchnia-z-wyspa-widok-na-salon-apartament-warszawa.webp';
---

<style lang="scss">
  @use './Hero.scss';
</style>

<section class="hero">
  <Image
    src={heroImg}
    alt="Wnętrze zaprojektowane przez NOKO Studio"
    class="hero__bg"
    width={1920}
    height={1080}
    format="webp"
    loading="eager"
  />
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <h1 class="hero__title">
      Tworzymy przestrzenie,
      <br />
      które inspirują
    </h1>
    <p class="hero__desc">
      Projektowanie wnętrz to nasza pasja. Łączymy funkcjonalność z estetyką,
      tworząc unikalne przestrzenie dopasowane do Twoich potrzeb.
    </p>
    <div class="hero__actions">
      <a href="/realizacje" class="hero__btn hero__btn--primary">
        Zobacz realizacje <span aria-hidden="true">→</span>
      </a>
      <a href="/uslugi" class="hero__btn hero__btn--secondary">
        Poznaj ofertę
      </a>
    </div>
  </div>
</section>
