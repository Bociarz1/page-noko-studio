---
import { Image } from 'astro:assets';
import heroImg from '@assets/images/kuchnia-z-wyspa-widok-na-salon-apartament-warszawa.webp';
import Button from '@components/shared/Button/Button.astro';
---

<style lang="scss">
  @use './Hero.scss';
</style>

<section class="hero">
  <Image
    src={heroImg}
    alt="Wnętrze zaprojektowane przez NOKO Studio"
    class="hero__bg"
    width={1920}
    height={1080}
    format="avif"
    quality="mid"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
    widths={[768, 1280, 1920]}
    sizes="100vw"
  />
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <h1 class="hero__pretitle page-pretitle">
      Profesjonalne projektowanie wnętrz w Białymstoku
    </h1>
    <p class="hero__title section-title">
      Stwórzmy razem 
    <br>
      Twoje wymarzone wnętrze,
      <br />
      bez stresu i niespodzianek
    </p>
    <p class="hero__desc section-description">
      Specjaliści od wnętrz: od pierwszej koncepcji aż po finalną realizację projektu.
    </p>
    <div class="hero__actions">
      <Button href="/realizacje" title="Zobacz realizacje" variant="primary" />
      <Button href="/uslugi" title="Poznaj ofertę" variant="secondary" />
    </div>
  </div>
</section>
