---
import { NavLinks, SectionIds } from "@constants/navLinks";
---
<style lang="scss">
  @use './CTA.scss';
</style>

<section id={SectionIds[NavLinks.HOME].cta} class="cta">
  <div class="cta__container">
    <h2 class="cta__title text-h1 font-semibold">
      Masz pomysł na wnętrze?
      <br />
      Przekujmy go w projekt!
    </h2>
    <p class="cta__description text-body-lg" style="line-height: 1.625;">
      Pozwól nam zająć się estetyką i ergonomią Twojej przestrzeni.
      Umów spotkanie i zróbmy pierwszy krok ku Twojemu nowemu wnętrzu.
    </p>
    <a href={NavLinks.CONTACT} class="cta__button">
      Zarezerwuj darmową konsultację
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
