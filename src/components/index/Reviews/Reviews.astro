---
import SectionHeader from '@components/shared/SectionHeader/SectionHeader.astro';
import { NavLinks, SectionIds } from '@constants/navLinks';
---
<style lang="scss">
  @use './Reviews.scss';
</style>

<section id={SectionIds[NavLinks.HOME].reviews} class="reviews">
  <div class="reviews__container">
    <SectionHeader
      pretitle="CO MÓWIĄ O NAS INWESTORZY? TWÓJ POLECANY PROJEKTANT WNĘTRZ Z BIAŁEGOSTOKU"
      pretitleAs="h2"
      title="Opinie naszych klientów"
      titleAs="p"
      alignment="center"
      class="reviews__header"
    />
    <div class="reviews__widget" id="reviews-widget-container">
    </div>
  </div>
</section>

<script>
  // Lazy-load trustindex only when the reviews section enters the viewport,
  // preventing its forced reflows from affecting the initial page load score.
  const widgetContainer = document.getElementById('reviews-widget-container');

  if (widgetContainer) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const script = document.createElement('script');
          script.src = 'https://cdn.trustindex.io/loader.js?88c83d572a4273338746f27a843';
          script.async = true;
          script.defer = true;
          widgetContainer.appendChild(script);
          observer.disconnect();
        }
      }
    }, { rootMargin: '200px' });

    observer.observe(widgetContainer);
  }
</script>
