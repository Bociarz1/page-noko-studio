---
import PortfolioItem from "@components/shared/PortfolioItem/PortfolioItem.astro";

const projects = [
  {
    slug: "projekt-1",
    cover: "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80",
    title: "Rezydencja pod Lasem",
    location: "Warszawa",
    index: "01",
    category: "mieszkalne",
    area: "320 m²",
    year: "2023"
  },
  {
    slug: "projekt-2",
    cover: "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80",
    title: "Biuro Architektoniczne",
    location: "Kraków",
    index: "02",
    category: "komercyjne",
    area: "150 m²",
    year: "2022"
  }
];
---
<style lang="scss">
  @use './Portfolio.scss';
</style>

<section class="portfolio">
  <div class="portfolio__container">
    <div class="portfolio__header">
      <div class="portfolio__header-text">
        <p class="label-eyebrow portfolio__eyebrow page-pretitle">ZOBACZ PORTFOLIO NASZEGO BIURA PROJEKTOWEGO</p>
        <h2 class="portfolio__title section-title">
          Zaprojektowane z pasją, dopracowane w każdym detalu
        </h2>
        <p class="portfolio__description section-description">
          Projekty mieszkalne i komercyjne, w których łączymy funkcjonalność
          z dopracowaną estetyką.
        </p>
      </div>
      <a href="/realizacje" class="portfolio__link">
        Zobacz wszystkie <span aria-hidden>→</span>
      </a>
    </div>

    <div class="portfolio__grid">
      {projects.map((p) => (
        <PortfolioItem
          slug={p.slug}
          cover={p.cover}
          title={p.title}
          location={p.location}
          index={p.index}
          category={p.category}
          area={p.area}
          year={p.year}
        />
      ))}
    </div>
  </div>
</section>
