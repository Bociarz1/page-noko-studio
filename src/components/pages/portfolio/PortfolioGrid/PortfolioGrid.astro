---
import PortfolioItem from '@components/shared/PortfolioItem/PortfolioItem.astro';
import { NavLinks, SectionIds } from 'src/consts/navLinks';

interface ProjectItem {
  slug: string;
  cover: ImageMetadata;
  title: string;
  location: string;
  category: string;
  area: string;
  pubDate: Date;
}

interface Props {
  projects: ProjectItem[];
}

const { projects } = Astro.props;
---

<style lang="scss">
  @use './PortfolioGrid.scss';
</style>

<section id={SectionIds[NavLinks.PORTFOLIO].grid} class="portfolio-grid">
  <div class="portfolio-grid__container">
    {
      projects.map((p) => (
        <PortfolioItem
          slug={p.slug}
          cover={p.cover}
          title={p.title}
          location={p.location}
          category={p.category}
          area={p.area}
          year={p.pubDate.getFullYear().toString()}
        />
      ))
    }
  </div>
</section>
