---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import './BlogItem.scss';
import { getEntry } from 'astro:content';
import { blogImages, resolveImage } from '@utils/imageImports';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const author = await getEntry(post.data.author);
const postImage = post.data.image ? await resolveImage(blogImages, post.data.image) : null;
---

<a href={`/blog/${post.id}/`} class="blog-card">
  <div class="blog-card__image-wrapper">
    {postImage ? (
      <Image 
        src={postImage} 
        alt={post.data.title} 
        class="blog-card__image"
        width={780}
        height={585}
        format="avif"
        loading="lazy"
        decoding="async"
        widths={[400, 600, 780]}
        sizes="(max-width: 767px) 100vw, (max-width: 1599px) 50vw, 780px"
      />
    ) : (
      <span class="blog-card__no-image">Brak zdjęcia</span>
    )}
  </div>
  
  <div class="blog-card__content">
    <div class="blog-card__text">
      <p class="blog-card__meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('pl-PL', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {' · '}{author?.data.name}
      </p>
      <h2 class="blog-card__title">{post.data.title}</h2>
      <p class="blog-card__details">{post.data.description}</p>
    </div>
    <span aria-hidden class="blog-card__arrow">→</span>
  </div>
</a>
