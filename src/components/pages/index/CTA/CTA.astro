---
import { NavLinks, SectionIds } from 'src/consts/navLinks';
---

<style lang="scss">
  @use './CTA.scss';
</style>

<section id={SectionIds[NavLinks.HOME].cta} class="cta">
  <div class="cta__container">
    <h2 class="cta__title">
      Masz pomysł na wnętrze?
      <br />
      Przekujmy go w projekt!
    </h2>
    <p class="cta__description">
      Pozwól nam zająć się estetyką i ergonomią Twojej przestrzeni. Umów spotkanie i zróbmy pierwszy
      krok ku Twojemu nowemu wnętrzu.
    </p>
    <a href={NavLinks.CONTACT} class="cta__button">
      Zarezerwuj darmową konsultację
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
