---
import ContactForm from '@components/shared/ContactForm/ContactForm.astro';
import ContactInfo from '@components/contact/ContactInfo/ContactInfo.astro';
import { NavLinks, SectionIds } from '@constants/navLinks';
---

<style lang="scss">
  @use './Contact.scss';
</style>

<section id={SectionIds[NavLinks.CONTACT].contact} class="contact">
  <div class="contact__container">
    <ContactInfo />

    <div class="contact__form-wrapper">
      <ContactForm />
    </div>
  </div>
</section>
