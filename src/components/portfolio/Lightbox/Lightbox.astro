---
import { Image } from 'astro:assets';

interface LightboxImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: LightboxImage[];
}

const { images } = Astro.props;
---

<style lang="scss">
  @use './Lightbox.scss';
</style>

<script>
  import './Lightbox.ts';
</script>

<div
  class="lightbox"
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Podgląd zdjęcia"
  aria-hidden="true"
>
  <div class="lightbox__backdrop" id="lightbox-backdrop"></div>

  <div class="lightbox__container">
    <header class="lightbox__header">
      <span class="lightbox__counter" id="lightbox-counter" aria-live="polite">1 / {images.length}</span>
      <button
        class="lightbox__close"
        id="lightbox-close"
        aria-label="Zamknij podgląd"
        type="button"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </header>

    <div class="lightbox__stage" id="lightbox-stage">
      <div class="lightbox__track" id="lightbox-track">
        {images.map((img) => (
          <div class="lightbox__slide">
            <Image
              src={img.src}
              alt={img.alt}
              width={1600}
              height={1200}
              format="avif"
              quality="high"
              loading="lazy"
              decoding="async"
              widths={[800, 1200, 1600]}
              sizes="(max-width: 767px) 100vw, (max-width: 1199px) 80vw, 1200px"
            />
          </div>
        ))}
      </div>

      {images.length > 1 && (
        <>
          <button class="lightbox__btn lightbox__btn--prev" id="lightbox-prev" aria-label="Poprzednie zdjęcie" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button class="lightbox__btn lightbox__btn--next" id="lightbox-next" aria-label="Następne zdjęcie" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </>
      )}
    </div>

    {images.length > 1 && (
      <nav class="lightbox__dots" aria-label="Nawigacja po zdjęciach">
        {images.map((_, i) => (
          <button
            class={`lightbox__dot${i === 0 ? ' lightbox__dot--active' : ''}`}
            data-index={i}
            aria-label={`Zdjęcie ${i + 1}`}
            type="button"
          ></button>
        ))}
      </nav>
    )}
  </div>
</div>
