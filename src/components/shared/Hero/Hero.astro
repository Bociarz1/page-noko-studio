---
import { Image } from 'astro:assets';
import SectionHeader from '@components/shared/SectionHeader/SectionHeader.astro';

interface Props {
  preTitle: string;
  title: string;
  description: string;
  image: {
    src: ImageMetadata;
    alt: string;
    sizes: string;
  };
  height?: string;
  id?: string;
}

const { preTitle, title, description, image, height, id } = Astro.props;
const {src, alt, sizes} = image;
---

<style lang="scss">
  @use './Hero.scss';
</style>

<section id={id} class="hero" style={height ? `--hero-height: ${height}` : null}>
  <Image
    src={src}
    alt={alt}
    class="hero__bg"
    width={1600}
    height={900}
    format="avif"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    widths={[360, 540, 720, 1024, 1280, 1600]}
    sizes={sizes}
  />
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <SectionHeader
      pretitle={preTitle}
      pretitleAs="h1"
      title={title}
      titleAs="p"
      description={description}
      alignment="center"
      class="hero__header"
    />
    <div class="hero__actions">
      <slot/>
    </div>
  </div>
</section>
