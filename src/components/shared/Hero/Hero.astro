---
import { Image } from 'astro:assets';
import Button from '@components/shared/Button/Button.astro';

interface Props {
  preTitle: string;
  title: string;
  description: string;
  image: {
    src: ImageMetadata | string;
    alt: string;
    sizes: string;
  };
  height?: string;
  id?: string;
}

const { preTitle, title, description, image, height, id } = Astro.props;
const {src, alt, sizes} = image;
---

<style lang="scss">
  @use './Hero.scss';
</style>

<section id={id} class="hero" style={height ? `--hero-height: ${height}` : null}>
  <Image
    src={src}
    alt={alt}
    class="hero__bg"
    width={1600}
    height={900}
    format="avif"
    quality={25}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    widths={[640, 1024, 1600]}
    sizes={sizes}
  />
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <h1 class="hero__pretitle page-pretitle">
      {preTitle}
    </h1>
    <p class="hero__title section-title">
      {title}
    </p>
    <p class="hero__desc section-description">
      {description}
    </p>
    <div class="hero__actions">
      <slot/>
    </div>
  </div>
</section>
