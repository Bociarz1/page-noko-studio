---
import { NAV_ELEMENTS, NavLinks } from 'src/consts/navLinks';
import { COMPANY } from 'src/consts/site';
import LocationOn from '@assets/icons/icon-location-on.svg';
import PhoneInTalk from '@assets/icons/icon-phone-in-talk.svg';
import Mail from '@assets/icons/icon-mail.svg';
import Facebook from '@assets/icons/icon-facebook.svg';
import Instagram from '@assets/icons/icon-instagram.svg';
---

<style lang="scss">
  @use './Footer.scss';
</style>

<footer class="footer">
  <div class="footer__content">
    <section class="footer__brand">
      <p class="footer__logo">
        <span class="footer__logo-text">NOKO</span>
        <span class="footer__logo-text footer__logo-text--bold">STUDIO</span>
      </p>
      <p class="footer__description">Projektowanie wnętrz z pasją i dbałością o każdy detal</p>
    </section>
    <section class="footer__nav">
      <p class="footer__title">Menu</p>
      <ul class="footer__nav-list">
        {
          NAV_ELEMENTS.map((element) => (
            <li class="footer__nav-item">
              <a class="footer__nav-link" href={element.href}>
                {element.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    <section class="footer__contact">
      <p class="footer__title">Kontakt</p>
      <address class="footer__contact-details">
        <div class="footer__contact-row">
          <Mail width={16} height={16} />
          {COMPANY.email}
        </div>
        <div class="footer__contact-row">
          <PhoneInTalk width={16} height={16} />
          {COMPANY.phones.aleksandra.name}
          {COMPANY.phones.aleksandra.formatted}
        </div>
        <div class="footer__contact-row">
          <PhoneInTalk width={16} height={16} />
          {COMPANY.phones.paulina.name}
          {COMPANY.phones.paulina.formatted}
        </div>
        <div class="footer__contact-row">
          <LocationOn width={20} height={20} />
          {COMPANY.address.fullMap}
        </div>
      </address>
      <div class="footer__socials">
        <a
          class="footer__social-link"
          href={NavLinks.INSTAGRAM}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <Instagram class="footer__social-icon" width={20} height={20} aria-hidden="true" />
          Instagram
        </a>
        <a
          class="footer__social-link"
          href={NavLinks.FACEBOOK}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <Facebook class="footer__social-icon" width={20} height={20} aria-hidden="true" />
          Facebook
        </a>
      </div>
    </section>
    <section class="footer__working-hours">
      <p class="footer__title">Godziny pracy</p>
      <div class="footer__working-hours-details">
        <p>Pon - Pt: 9:00 - 17:00</p>
        <p>Sob - Nd: Zamknięte</p>
      </div>
    </section>
  </div>
  <div class="footer__copyright">
    <span>© 2026 NOKO STUDIO. Wszystkie prawa zastrzeżone.</span>
    <div class="footer__legal-links">
      <a class="footer__legal-link" href={NavLinks.PRIVACY_POLICY}>Polityka prywatności</a>
      <span class="footer__separator">|</span>
      <a class="footer__legal-link" href={NavLinks.TERMS_OF_SERVICE}>Regulamin</a>
    </div>
  </div>
</footer>
