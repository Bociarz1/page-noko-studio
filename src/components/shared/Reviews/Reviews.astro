---
import { reviews } from '@libs/googlePlaces/googlePlaces.ts';
import { Image } from 'astro:assets';

const getInitials = (name: string) => {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length >= 2) {
    return `${parts[0][0]}${parts[1][0]}`.toUpperCase();
  }
  return name.slice(0, 2).toUpperCase();
};
---
<style lang="scss">
  @use './Reviews.scss';
</style>

{reviews.length > 0 && (
  <section class="reviews-section">
    <div class="reviews-section__container">
      
      <div class="reviews-section__header-row">
        <div class="reviews-section__header-text">
          <h2 class="reviews-section__title">Opinie klientów, którym stworzyliśmy projekt wnętrza</h2>
          <p class="reviews-section__desc">
            Naszym największym wyróżnieniem są rekomendacje zadowolonych klientów. Detale w projektowaniu wnętrz, terminowość, estetyka i funkcjonalność to wartości, które doceniają nasi zleceniodawcy.
            <br/><br/>
            Dziękujemy za zaufanie. Opinie klientów są dla nas najważniejszą motywacją do dalszej pracy.
          </p>
          <a
            href="https://www.google.com/maps/place/NOKO+Studio+-+Projektowanie+wn%C4%99trz+Bia%C5%82ystok/@53.1132789,23.1136224,10z/data=!3m1!4b1!4m6!3m5!1s0x972752c23bc87bf:0x34db8cae46701457!8m2!3d53.1132789!4d23.1136224!16s%2Fg%2F11x7z1p193"
            target="_blank"
            rel="noopener noreferrer"
            class="reviews-section__google-badge"
          >
            <svg class="google-badge-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Średnia ocena <strong>5.0 / 5.0</strong> na podstawie 17 opinii w Google Maps &rarr;</span>
          </a>
        </div>
        <div class="reviews-slider__controls">
          <button id="review-prev" class="reviews-slider__btn" aria-label="Poprzednia opinia">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button id="review-next" class="reviews-slider__btn" aria-label="Następna opinia">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>
      
      <div class="reviews-slider">
        <div class="reviews-slider__track" id="reviews-track">
          {reviews.map((review) => (
            <article class="review-card">
              <header class="review-card__header">
                <div class="review-card__avatar">
                  {review.profile_photo_url ? (
                    <Image
                      src={review.profile_photo_url}
                      alt={`Avatar ${review.author_name}`}
                      width={48}
                      height={48}
                      format="avif"
                      widths={[48, 96]}
                      sizes="48px"
                      loading="lazy"
                    />
                  ) : (
                    <div class="review-card__avatar-fallback">{getInitials(review.author_name)}</div>
                  )}
                </div>
                <div class="review-card__meta">
                  {review.author_url && review.author_url !== '#' ? (
                    <a
                      href={review.author_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="review-card__author-link"
                    >
                      <h3 class="review-card__author">{review.author_name}</h3>
                    </a>
                  ) : (
                    <h3 class="review-card__author">{review.author_name}</h3>
                  )}
                  <div class="review-card__stars" role="img" aria-label={`Ocena: ${review.rating} na 5`}>
                    {Array.from({ length: 5 }).map((_, i) => (
                      <svg
                        class={`star ${i < review.rating ? 'star--active' : ''}`}
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                      </svg>
                    ))}
                  </div>
                  <span class="review-card__date">{review.relative_time_description}</span>
                </div>
              </header>
              <blockquote class="review-card__content">
                <p>"{review.text}"</p>
              </blockquote>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<script>
  const track = document.getElementById('reviews-track');
  const prevBtn = document.getElementById('review-prev');
  const nextBtn = document.getElementById('review-next');
  
  if (track && prevBtn && nextBtn) {
    let isTransitioning = false; // Blokada przed klikaniem strzałki w trakcie animacji

    const getSlideWidth = () => {
      const card = track.firstElementChild as HTMLElement;
      if (!card) return 0;
      const gap = parseInt(window.getComputedStyle(track).gap || '32');
      return card.offsetWidth + gap;
    };

    const slideNext = () => {
      if (isTransitioning) return;
      isTransitioning = true;
      
      const slideWidth = getSlideWidth();
      track.style.transition = 'transform 0.4s ease-in-out';
      track.style.transform = `translateX(-${slideWidth}px)`;

      const handleTransitionEnd = () => {
        track.removeEventListener('transitionend', handleTransitionEnd);
        track.style.transition = 'none'; // Wyłączamy animację do przeskoku
        track.appendChild(track.firstElementChild as Node); // Przenosimy pierwszy element na koniec
        track.style.transform = 'translateX(0)'; // Resetujemy pozycję
        isTransitioning = false;
      };

      track.addEventListener('transitionend', handleTransitionEnd);
    };

    const slidePrev = () => {
      if (isTransitioning) return;
      isTransitioning = true;

      const slideWidth = getSlideWidth();
      
      // Krok 1: Szybko przerzucamy ostatni element na początek bez animacji
      track.style.transition = 'none';
      track.prepend(track.lastElementChild as Node);
      
      // Krok 2: Ustawiamy "fałszywą" pozycję wstecz, by z niej wjechać
      track.style.transform = `translateX(-${slideWidth}px)`;

      // Krok 3: Wymuszamy przerysowanie ramki przez przeglądarkę, po czym wracamy do zera Z ANIMACJĄ
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          track.style.transition = 'transform 0.4s ease-in-out';
          track.style.transform = 'translateX(0)';
        });
      });

      const handleTransitionEnd = () => {
        track.removeEventListener('transitionend', handleTransitionEnd);
        isTransitioning = false;
      };

      track.addEventListener('transitionend', handleTransitionEnd);
    };

    // Podpięcie przycisków
    nextBtn.addEventListener('click', slideNext);
    prevBtn.addEventListener('click', slidePrev);

    // Autoplay
    let autoScroll = setInterval(slideNext, 4000);

    const sliderContainer = track.closest('.reviews-slider');
    if (sliderContainer) {
      sliderContainer.addEventListener('mouseenter', () => clearInterval(autoScroll));
      sliderContainer.addEventListener('mouseleave', () => {
        autoScroll = setInterval(slideNext, 4000);
      });
    }
  }
</script>
