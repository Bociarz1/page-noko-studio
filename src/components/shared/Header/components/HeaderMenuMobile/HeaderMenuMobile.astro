---
import Menu from '@assets/icons/icon-menu.svg';
import { NavLink, NAV_ELEMENTS } from 'src/constants/navLinks';

interface Props {
  navElements: NavLink[];
}
const { navElements = [] } = Astro.props;
---

<style lang="scss">
  @use '@components/shared/Header/Header.scss';
  @use './HeaderMenuMobile.scss';
</style>

<details class="header-menu-mobile">
  <summary>
    <Menu class="icon-menu" fill="black" />
  </summary>
  <ul class="header-menu-mobile__link-wrapper">
    {
      navElements.map((element) => (
        <li class={element?.isPathActive ? 'link--active' : ''}>
          <a href={element.href}>{element.label}</a>
        </li>
      ))
    }
  </ul>
</details>
