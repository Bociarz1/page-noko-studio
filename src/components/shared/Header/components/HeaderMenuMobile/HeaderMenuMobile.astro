---
import Menu from '@assets/icons/icon-menu.svg';
import type { INavLink } from 'src/consts/navLinks';


interface Props {
  navElements: INavLink<any>[];
}
const { navElements = [] } = Astro.props;
---

<style lang="scss">
  @use './HeaderMenuMobile.scss';
</style>

<details class="mobile-nav">
  <summary class="mobile-nav__toggle">
    <Menu class="mobile-nav__icon" fill="black" />
  </summary>
  <ul class="mobile-nav__list">
    {
      navElements.map((element) => (
        <li class={`mobile-nav__item ${element?.isPathActive ? 'mobile-nav__item--active' : ''}`}>
          <a class="mobile-nav__link" href={element.href}>
            {element.label}
          </a>
        </li>
      ))
    }
  </ul>
</details>
