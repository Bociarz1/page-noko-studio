---
import { NavLink } from 'src/constants/navLinks';

interface Props {
  navElements: NavLink[];
}
const { navElements = [] } = Astro.props;
---

<style lang="scss">
  @use './HeaderMenu.scss';
</style>

<ul class="header-nav">
  {
    navElements.map((element) => (
      <li class={`header-nav__item ${element?.isPathActive ? 'header-nav__item--active' : ''}`}>
        <a class="header-nav__link" href={element.href}>{element.label}</a>
      </li>
    ))
  }
</ul>