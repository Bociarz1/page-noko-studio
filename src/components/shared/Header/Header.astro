---
import HeaderMenu from '@components/shared/Header/components/HeaderMenu/HeaderMenu.astro';
import HeaderMenuMobile from '@components/shared/Header/components/HeaderMenuMobile/HeaderMenuMobile.astro';
import { NAV_ELEMENTS, NavLinks } from 'src/constants/navLinks';
import Facebook from '@assets/icons/icon-facebook.svg';
import Instagram from '@assets/icons/icon-instagram.svg';
---

<style lang="scss">
  @use './Header.scss';
</style>

<script>
  import './HeaderMenu.ts';
</script>

<nav class="header">
  <div class="header__container">
    <a class="header__logo" href="/">
      <span class="header__logo-text">NOKO</span>
      <span class="header__logo-text header__logo-text--bold">STUDIO</span>
    </a>
    <div class="header__socials">
      <a class="header__social-link" href={NavLinks.FACEBOOK} target="_blank" aria-label="Facebook">
        <Facebook width="20" height="20" color="gray" aria-hidden="true" />
      </a>
      <a class="header__social-link" href={NavLinks.INSTAGRAM} target="_blank" aria-label="Instagram">
        <Instagram width="20" height="20" color="gray" aria-hidden="true" />
      </a>
    </div>
  </div>
  <HeaderMenuMobile navElements={NAV_ELEMENTS} />
  <HeaderMenu navElements={NAV_ELEMENTS} />
</nav>
