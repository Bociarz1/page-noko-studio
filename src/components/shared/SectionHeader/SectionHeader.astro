---
import styles from './SectionHeader.module.scss';

interface Props {
  pretitle?: string;
  title?: string;
  description?: string;
  pretitleAs?: 'h1' | 'h2' | 'h3' | 'p' | 'span';
  titleAs?: 'h1' | 'h2' | 'h3' | 'p';
  descriptionAs?: 'p' | 'div' | 'span';
  alignment?: 'left' | 'center' | 'right';
  class?: string;
}

const {
  pretitle,
  title,
  description,
  pretitleAs: PretitleTag = 'p',
  titleAs: TitleTag = 'h2',
  descriptionAs: DescriptionTag = 'p',
  alignment = 'left',
  class: className = '',
} = Astro.props;

const finalClass = `section-header align-${alignment} ${styles.wrapper} ${className}`.trim();
---

<style lang="scss">
  @use './SectionHeader.scss';
</style>

<div class={finalClass}>
  {pretitle && <PretitleTag class={styles.pretitle}>{pretitle}</PretitleTag>}
  {title && <TitleTag class={styles.title}>{title}</TitleTag>}
  {description && <DescriptionTag class={styles.description}>{description}</DescriptionTag>}
</div>
