---
import { NavLink } from "@constants/navLinks";


---
<style lang="scss">
  @use './CookiePopup.scss';
</style>

<div class="cookie-popup" id="cookie-popup">
  <div class="cookie-popup__container">
    <p class="cookie-popup__text">
      Nasza strona korzysta z plików cookies, aby zapewnić Ci najlepszą
      jakość przeglądania oraz analizować ruch. Szczegóły znajdziesz w
      naszej <a href={NavLink.PRIVACY_POLICY}>Polityce Prywatności</a>.
    </p>
    <button id="cookie-accept" class="cookie-popup__button">
      Akceptuję
    </button>
  </div>
</div>

<script>
  const popup = document.getElementById('cookie-popup');
  const acceptBtn = document.getElementById('cookie-accept');

  if (popup && acceptBtn) {
    const isAccepted = localStorage.getItem('cookie-consent');
    if (!isAccepted) {
      popup.classList.add('is-visible');
    }

    acceptBtn.addEventListener('click', () => {
      localStorage.setItem('cookie-consent', 'accepted');
      popup.classList.remove('is-visible');
      
      //TODO: GA script
    });
  }
</script>
