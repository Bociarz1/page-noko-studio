---
import MainLayout from '@layouts/MainLayout/MainLayout.astro';
import { buildProjectSchema } from '@seo/projectSchema';
import { BASE_URL } from '@consts/site';
import ProjectDetails from '@components/pages/portfolioDetails/ProjectDetails/ProjectDetails.astro';
import { portfolioImages, resolveImage } from '@utils/imageImports';

import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const rawProjects = await getCollection('portfolio');
  return rawProjects.map((project) => ({
    params: { slug: project.id },
    props: { project: { slug: project.id, ...project.data } },
  }));
}

const { project } = Astro.props;

// Rozwiązujemy okładkę i galerię przez glob
const coverMeta = await resolveImage(portfolioImages, project.cover);
const galleryMeta = await Promise.all(
  (project.gallery || []).map(async (img) => ({
    src: await resolveImage(portfolioImages, img.src),
    alt: img.alt,
  }))
);

const schema = buildProjectSchema({
  slug: project.slug,
  title: project.title,
  description: project.description,
  pubDate: project.pubDate,
  imageSrcs: [coverMeta.src],
});
---

<MainLayout
  title={`${project.title} | NOKO Studio`}
  metaDescription={project.description}
  ogImage={coverMeta.src}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <ProjectDetails project={{ ...project, cover: coverMeta, gallery: galleryMeta }} />
</MainLayout>
