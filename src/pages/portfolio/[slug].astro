---
import MainLayout from '@layouts/MainLayout/MainLayout.astro';
import { buildProjectSchema } from '@seo/projectSchema';
import { BASE_URL } from '@consts/site';
import ProjectDetails from '@components/pages/portfolioDetails/ProjectDetails/ProjectDetails.astro';

import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const rawProjects = await getCollection('portfolio');
  return rawProjects.map((project) => ({
    params: { slug: project.id },
    props: { project: { slug: project.id, ...project.data } },
  }));
}

const { project } = Astro.props;

const schema = buildProjectSchema({
  slug: project.slug,
  title: project.title,
  description: project.description,
  year: project.year,
  imageSrcs: (project.gallery || []).map((img) => new URL(img.src.src, Astro.site || BASE_URL).href),
});
---

<MainLayout
  title={`${project.title} | NOKO Studio`}
  metaDescription={project.description}
  ogImage={new URL(project.cover.src, Astro.site || BASE_URL).href}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <ProjectDetails project={project} />
</MainLayout>
