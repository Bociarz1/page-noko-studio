---
import { getCollection, getEntry, render } from 'astro:content';
import ArticleLayout from '@layouts/ArticleLayout/ArticleLayout.astro';
import { blogImages, authorImages, resolveImage } from '@utils/imageImports';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const author = await getEntry(post.data.author);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://noko-studio.pl').href;
const heroImageMeta = await resolveImage(blogImages, post.data.image);
const authorAvatarMeta = await resolveImage(authorImages, author.data.avatar);
---

<ArticleLayout
  title={post.data.title}
  metaTitle={post.data.metaTitle}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={{ ...author.data, avatar: authorAvatarMeta }}
  heroImage={heroImageMeta}
  url={canonicalUrl}
  headings={headings}
  rawContent={post.body || ''}
  faq={post.data.faq}
>
  <Content />
</ArticleLayout>
