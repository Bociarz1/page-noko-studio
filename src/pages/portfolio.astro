---
import MainLayout from "@layouts/MainLayout/MainLayout.astro";
import Hero from "@components/shared/Hero/Hero.astro";
import PortfolioGrid from "@components/portfolio/PortfolioGrid/PortfolioGrid.astro";
import heroImg from '@assets/images/kuchnia-z-wyspa-widok-na-salon-apartament-warszawa.webp';
import { projects } from "@data/projects";

const heroProps = {
  preTitle: 'Nasze projekty wnętrz.',
  title: 'Zainspiruj się naszymi realizacjami',
  description: 'Przeglądaj wybrane projekty domów, mieszkań i apartamentów. Zobacz nasze podejście do detali, ergonomii i estetyki, które zamieniają wizje w piękne, funkcjonalne wnętrza.',
  image: {
    src: heroImg,
    alt: 'Wnętrze zaprojektowane przez NOKO Studio',
    sizes: '60vw',
  },
  height: 'auto',
}
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://noko-studio.pl/portfolio/#webpage",
      "url": "https://noko-studio.pl/portfolio",
      "name": "Portfolio – NOKO Studio",
      "description": "Realizacje i projekty wnętrz NOKO Studio. Projekty domów i apartamentów z pasją i dbałością o detal.",
      "isPartOf": {
        "@id": "https://noko-studio.pl/#website"
      }
    },
    {
      "@type": "ItemList",
      "itemListElement": projects.map((project, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "url": `https://noko-studio.pl/portfolio/${project.slug}`
      }))
    }
  ]
};
---

<MainLayout title="Portfolio Projektów Wnętrz – Realizacje NOKO Studio" metaDescription="Odkryj portfolio NOKO Studio. Zobacz nasze zrealizowane projekty i aranżacje wnętrz: domy, mieszkania oraz apartamenty. Zainspiruj się już dzisiaj!">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Hero {...heroProps} />
  <PortfolioGrid projects={projects} />
</MainLayout>