---
import MainLayout from '@layouts/MainLayout/MainLayout.astro';
import Hero from '@components/shared/Hero/Hero.astro';
import OurServices from '@components/pages/index/OurServices/OurServices.astro';
import AboutUs from '@components/pages/index/AboutUs/AboutUs.astro';
import Portfolio from '@components/pages/index/Portfolio/Portfolio.astro';
import CTA from '@components/pages/index/CTA/CTA.astro';
import Reviews from '@components/shared/Reviews/Reviews.astro';
import heroImg from '@assets/images/kuchnia-z-wyspa-widok-na-salon-apartament-warszawa.webp';
import Button from '@components/shared/Button/Button.astro';
import { NavLinks, SectionIds } from '@consts/navLinks';
import { buildHomeSchema } from '@seo/homeSchema';

const metaData = {
  title: 'Architekt Wnętrz Białystok | NOKO Studio',
  metaDescription:
    'NOKO Studio – profesjonalny architekt wnętrz w Białymstoku i w całej Polsce. Kompleksowa aranżacja i architektura domów, mieszkań i apartamentów.',
};
const schema = buildHomeSchema();
const heroProps = {
  preTitle: 'NOKO STUDIO - Twój architekt wnętrz z Białegostoku',
  title: 'Stwórzmy razem Twoje wymarzone wnętrze, bez stresu i niespodzianek',
  description: 'Specjaliści od wnętrz: od pierwszej koncepcji aż po finalną realizację projektu.',
  image: {
    src: heroImg,
    alt: 'Wnętrze zaprojektowane przez NOKO Studio',
    sizes: '100vw',
  },
};
---

<MainLayout {...metaData}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Hero {...heroProps} id={SectionIds[NavLinks.HOME].hero}>
    <Button href={NavLinks.PORTFOLIO} title="Zobacz realizacje" variant="primary" />
    <Button href={NavLinks.OFFER} title="Poznaj ofertę" variant="secondary" />
  </Hero>
  <OurServices />
  <Portfolio />
  <AboutUs />
  <CTA />
  <Reviews />
</MainLayout>
