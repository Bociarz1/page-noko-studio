---
import MainLayout from '@layouts/MainLayout/MainLayout.astro';
import Hero from '@components/shared/Hero/Hero.astro';
import OurServices from '@components/index/OurServices/OurServices.astro';
import AboutUs from '@components/index/AboutUs/AboutUs.astro';
import Portfolio from '@components/index/Portfolio/Portfolio.astro';
import CTA from '@components/index/CTA/CTA.astro';
import Reviews from '@components/index/Reviews/Reviews.astro';
import heroImg from '@assets/images/kuchnia-z-wyspa-widok-na-salon-apartament-warszawa.webp';
import Button from '@components/shared/Button/Button.astro';
import { NavLinks, SectionIds } from '@constants/navLinks';


const heroProps = {
  preTitle: 'Architekt i projektant wnętrz: Poznaj naszą ofertę i pakiety usług',
  title: 'Stwórzmy razem Twoje wymarzone wnętrze, bez stresu i niespodzianek',
  description: 'Specjaliści od wnętrz: od pierwszej koncepcji aż po finalną realizację projektu.',
  image: {
    src: heroImg,
    alt: 'Wnętrze zaprojektowane przez NOKO Studio',
    sizes: '100vw',
  },
}
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://noko-studio.pl/#website",
      "url": "https://noko-studio.pl/",
      "name": "NOKO Studio",
      "description": "Profesjonalne projektowanie wnętrz w Białymstoku i całej Polsce.",
      "publisher": {
        "@id": "https://noko-studio.pl/#organization"
      }
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://noko-studio.pl/#organization",
      "name": "NOKO Studio",
      "legalName": "NOKO Studio Pracownia Architektury Wnętrz",
      "url": "https://noko-studio.pl",
      "logo": "https://noko-studio.pl/favicon.svg",
      "image": "https://noko-studio.pl/assets/images/kuchnia-z-wyspa-widok-na-salon-apartament-warszawa.webp",
      "telephone": [
        "+48455408602",
        "+48455408601"
      ],
      "email": "biuro@noko-studio.pl",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Białystok",
        "addressRegion": "Podlaskie",
        "addressCountry": "PL"
      },
      "areaServed": [
        {
          "@type": "AdministrativeArea",
          "name": "Białystok"
        },
        {
          "@type": "Country",
          "name": "Polska"
        }
      ],
      "priceRange": "$$"
    }
  ]
};
---

<MainLayout title="Projektowanie Wnętrz Białystok | Architekt NOKO Studio" metaDescription="NOKO Studio – profesjonalne projektowanie wnętrz w Białymstoku i w całej Polsce. Kompleksowa aranżacja i architektura domów, mieszkań i apartamentów.">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Hero {...heroProps} id={SectionIds[NavLinks.HOME].hero}>
    <Button href={NavLinks.PORTFOLIO} title="Zobacz realizacje" variant="primary" />
    <Button href={NavLinks.OFFER} title="Poznaj ofertę" variant="secondary" />
  </Hero>
  <OurServices />
  <Portfolio />
  <AboutUs />
  <CTA />
  <Reviews />
</MainLayout>
