---
import { LIB_PREFIX } from '../../config';

interface Props {
  href: string;
  title: string;
  class?: string;
}

const { href, title, class: className = '' } = Astro.props;
---

<style lang="scss">
  @use './Button.scss';
</style>

<a href={href} class={`${LIB_PREFIX}btn ${className}`}>
  <slot name="beforeIcon" />
  {title}
  <slot name="afterIcon" />
</a>
