---
interface Props {
  class?: string;
  alignment?: 'left' | 'center' | 'right';
}

const { class: className = '', alignment = 'left' } = Astro.props;
---

<style lang="scss">
  @use './UiSectionHeader.scss';
</style>

<div class={`ui-section-header align-${alignment} ${className}`}>
  <slot name="pretitle" />
  <slot name="title" />
  <slot name="description" />
</div>
