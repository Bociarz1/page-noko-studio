---
import Header from '@components/Header/Header.astro';
import Footer from '@components/Footer/Footer.astro';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  metaDescription: string;
}

const { title = '', metaDescription = '' } = Astro.props;
---

<style lang="scss" is:global>
  @use '@styles/_global.scss';
</style>
<style lang="scss">
  @use './MainLayout.scss';
</style>

<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: https://images.unsplash.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; upgrade-insecure-requests;" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="preload" href="/_astro/fonts/3494249176668fcb.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/_astro/fonts/e714b15c1070f5ec.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <Font cssVariable="--font-montserrat" />
  </head>
  <body>
    <Header />
    <main class="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
