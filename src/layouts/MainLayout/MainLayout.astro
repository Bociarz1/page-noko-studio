---
import Header from '@components/shared/Header/Header.astro';
import Footer from '@components/shared/Footer/Footer.astro';
import CookiePopup from '@components/shared/CookiePopup/CookiePopup.astro';
import FloatingPhone from '@components/shared/FloatingPhone/FloatingPhone.astro';
import SEO from '@libs/ui/components/SEO/SEO.astro';
import '@fontsource-variable/montserrat';

interface Props {
  title: string;
  metaDescription: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'profile';
}

const {
  title = '',
  metaDescription = '',
  canonicalUrl,
  ogImage,
  noindex = false,
  type = 'website',
} = Astro.props;
---

<style lang="scss" is:global>
  @use '@styles/_global.scss';
</style>
<style lang="scss">
  @use './MainLayout.scss';
</style>

<html lang="pl">
  <head>
    <SEO 
      title={title}
      metaDescription={metaDescription}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      siteName="NOKO Studio"
      noindex={noindex}
      type={type}
    />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main class="main">
      <slot />
    </main>
    <Footer />
    <CookiePopup />
    <FloatingPhone />
  </body>
</html>
